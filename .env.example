# 복사해서 .env 로 저장하세요 (cp .env.example .env)

# Claude API 키 — 없으면 AI 기능은 규칙 기반 제안으로 동작합니다
ANTHROPIC_API_KEY=

# 사용할 Claude 모델 (기본: claude-opus-5)
# CLAUDE_MODEL=claude-opus-5

# 서버 주소/포트 (기본: 127.0.0.1:5178). 같은 네트워크의 다른 사람에게 웹 뷰어를 보여주려면 HOST=0.0.0.0
# HOST=127.0.0.1
# PORT=5178

# 데이터(JSON) 저장 폴더 (기본: ./data)
# DATA_DIR=./data
