# 복사해서 .env 로 저장하세요 (cp .env.example .env). .env 는 절대 Git 에 올리지 마세요.

# ── 기본 ────────────────────────────────────────────────
# 서버 주소/포트 (기본: 127.0.0.1:5178 — 이 컴퓨터에서만 접속)
# HOST=127.0.0.1
# PORT=5178

# 사용자가 브라우저로 접속하는 공개 주소. 외부에 공개할 때는 반드시 https 주소로 지정하세요.
# (Render 에서는 비워 두면 https://<서비스이름>.onrender.com 을 자동으로 씁니다)
# 메일 링크, 소셜 로그인 콜백, 요청 출처(Origin) 검사, 쿠키 보안(Secure, __Host-)에 쓰입니다.
# APP_URL=https://refboard.example.com

# 리버스 프록시(Caddy, Nginx, 로드밸런서) 뒤에서 실행하면 프록시 단계 수 (보통 1).
# 프록시 없이 직접 공개할 때는 비워 두세요 — 잘못 켜면 IP 기반 요청 제한을 우회당합니다.
# TRUST_PROXY=1

# 데이터베이스(SQLite) 저장 폴더 (기본: ./data). 정기 백업: npm run backup
# DATA_DIR=./data

# ── 가입·로그인 ─────────────────────────────────────────
# 메일 가입 허용 (false 면 이미 있는 계정과 소셜 로그인만)
# ALLOW_SIGNUP=true
# 가입 가능한 메일 도메인 제한 (쉼표 구분, 비우면 제한 없음). 예: shinsegae.com,emart.com
# SIGNUP_EMAIL_DOMAINS=
# '로그인 상태 유지'를 켰을 때: 유지 기간(일, 마지막 활동 기준) / 최대 수명(일, 활동과 무관하게 다시 로그인)
# 끄고 로그인하면 브라우저를 닫을 때 로그아웃되고, 서버에서도 12시간 무활동·최대 1일이면 만료됩니다
# SESSION_DAYS=14
# SESSION_MAX_DAYS=30

# ── 메일 발송 (가입 인증, 비밀번호 재설정, 팀 초대) ─────────────
# 비워 두면 메일 대신 서버 실행 창에 링크를 출력합니다.
# (이 컴퓨터에서만 쓰는 개인 실행이면 화면에도 바로 표시)
# 예) Gmail: smtp.gmail.com / 587 / 앱 비밀번호,  네이버: smtp.naver.com / 465 / SMTP_SECURE=true
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=RefBoard <no-reply@example.com>

# ── 소셜 로그인 (선택) ───────────────────────────────────
# 카카오: developers.kakao.com → 내 애플리케이션 → 앱 키(REST API 키), 보안(Client Secret)
#   Redirect URI: {APP_URL}/api/auth/oauth/kakao/callback
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# 네이버: developers.naver.com → 애플리케이션 등록 (네이버 로그인)
#   Callback URL: {APP_URL}/api/auth/oauth/naver/callback
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=

# ── AI ──────────────────────────────────────────────────
# Claude API 키 — 없으면 AI 글쓰기는 규칙 기반 초안만, AI 태그 제안은 'AI 연결 후 사용 가능' 안내만 보여줍니다
ANTHROPIC_API_KEY=
# 글쓰기(타이틀·설명·캡션)용 모델 — 품질 우선 (기본: claude-opus-5-5)
# CLAUDE_WRITING_MODEL=claude-opus-5-5
# 태그 제안처럼 가벼운 작업용 모델 — 빠르고 저렴하게 (기본: claude-haiku-4-5)
# CLAUDE_TAG_MODEL=claude-haiku-4-5
# (예전 이름 CLAUDE_MODEL 도 글쓰기 모델로 읽습니다)
# 1 이면 API 키가 있어도 AI 기능을 끕니다
# DISABLE_AI=

# ── 의견 보내기 · 관리자 ─────────────────────────────────
# '의견 보내기'로 들어온 내용을 받을 메일 (기본: cokean89@gmail.com). 위 SMTP 설정으로 보냅니다
# FEEDBACK_EMAIL=cokean89@gmail.com
# 받은 의견 목록(#/admin/feedback)을 볼 수 있는 계정 메일 (쉼표 구분, 비우면 FEEDBACK_EMAIL)
# 메일 인증을 마친 계정만 관리자로 인정합니다
# ADMIN_EMAILS=

# ── 기타 ────────────────────────────────────────────────
# 1 이면 사내망/로컬 주소 스크랩 허용 (기본은 차단 — SSRF 방지). 외부 공개 서버에서는 켜지 마세요.
# ALLOW_PRIVATE_FETCH=
# 백업 보관 개수 (npm run backup)
# BACKUP_KEEP=30
