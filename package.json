{
  "name": "refboard",
  "version": "0.9.0",
  "private": true,
  "description": "케이스 스터디 & 레퍼런스 정리 프로그램 — 키워드 저장/검색, 태그별 자동 레이아웃, AI 타이틀·캡션, 문서/웹뷰어 출력",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch --ignore ./data server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.ts --prod",
    "app": "vite build && tsx server/index.ts --prod --open",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "backup": "tsx scripts/backup.ts",
    "tokens": "tsx scripts/tokens.ts",
    "storage:migrate": "tsx scripts/migrate-storage.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.11",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
